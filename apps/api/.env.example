# =============================================================
# Digital Pavti Book - API Environment Variables
# Copy this file to .env and fill in your values
# =============================================================

# ── Application ──────────────────────────────────────────────
# Production values (Railway): NODE_ENV=production, BASE_URL=https://api.epavtibook.com,
# FRONTEND_URL=https://app.epavtibook.com. api.epavtibook.com / app.epavtibook.com are
# also hardcoded as a permanent CORS allowlist entry in main.ts regardless of what
# CORS_ORIGIN below is set to (see the comment there) — but CORS_ORIGIN should still be
# set correctly in Railway for any other origin (a staging domain, etc.) to work.
NODE_ENV=development
PORT=3001
BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────
DATABASE_URL="postgresql://pavti_user:pavti_password@localhost:5432/pavti_db?schema=public"

# ── JWT ───────────────────────────────────────────────────────
# Production: generate real, distinct random secrets — do NOT reuse the dev
# values here or between each other. e.g. `openssl rand -base64 48`.
JWT_SECRET=change-this-to-a-strong-random-secret-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-refresh-secret-too-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────
# Production: https://app.epavtibook.com (also hardcoded in main.ts as a
# permanent fallback — see the note above).
CORS_ORIGIN=http://localhost:3000

# SMS and the WhatsApp Business Cloud API were both removed — receipt
# sharing is a manual "Share via WhatsApp" click-to-chat link (wa.me), no
# API/credentials needed. Nothing to configure here for either.

# ── Puppeteer (PDF & pavti-image rendering) ────────────────────
# Leave unset locally — Puppeteer uses its own downloaded Chromium by
# default, which works fine on a normal desktop OS. In production (Railway),
# this is set by railway.json's startCommand to whatever `which chromium`
# resolves to (the nix-installed Chromium from nixpacks.toml, which brings
# its own required system libraries — Puppeteer's bundled download has none
# of those on Nixpacks' minimal Node image and will fail to launch there).
PUPPETEER_EXECUTABLE_PATH=

# ── Cloudflare R2 (File Storage) ──────────────────────────────
# S3-compatible object storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=pavti-files
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── Razorpay (Platform subscription billing — Mandal pays Digital Pavti) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Cashfree (Donation collection — donor pays Mandal via Easy Split) ────
# See Digital_Pavti_Cashfree_EasySplit_Developer_Handover.md.
# Leave unset in any env that doesn't need online donations yet — the app
# boots fine without these; CashfreeService just refuses payment calls
# until all five below are set.
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2025-01-01
CASHFREE_BASE_URL=https://sandbox.cashfree.com/pg
# Production: CASHFREE_RETURN_URL=https://app.epavtibook.com/payment/cashfree/return,
# CASHFREE_NOTIFY_URL=https://api.epavtibook.com/api/v1/payments/cashfree/webhook —
# and CASHFREE_ENV/CASHFREE_BASE_URL flip to the live (non-sandbox) values only once
# donations are meant to be real; this whole page is currently an internal sandbox
# test surface (see apps/web's /settings/payments-test), not the public donation flow.
CASHFREE_RETURN_URL=http://localhost:3010/payment/cashfree/return
CASHFREE_NOTIFY_URL=https://your-public-domain.com/api/v1/payments/cashfree/webhook
