// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  TREASURER
  COLLECTOR
  VIEWER
}

enum SubscriptionPlan {
  FREE
  BASIC
  STANDARD
  PREMIUM
}

// PENDING_PAYMENT: self-serve signup created the org already (so they can
// start exploring immediately) but payment hasn't been manually confirmed
// yet — there's no payment gateway wired up, so an admin flips this to
// ACTIVE once payment for the season is actually received.
enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
}

enum CollectionType {
  DONATION
  INTERNAL
}

enum ReceiptStatus {
  PAID
  PENDING
  CANCELLED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum PaymentMode {
  CASH
  UPI
  CHEQUE
  BANK_TRANSFER
  ONLINE
}

// Payment gateway a donation was collected through — kept distinct from
// Receipt.paymentMode (CASH/UPI/CHEQUE/...), which just describes how the
// money physically changed hands and applies to receipts entered manually
// by a collector too. `provider` on Payment is which gateway processed it;
// RAZORPAY is reserved for platform subscription billing (org -> platform),
// never a donation, so donation Payments are CASHFREE only for now — see
// Digital_Pavti_Cashfree_EasySplit_Developer_Handover.md.
enum PaymentProvider {
  CASHFREE
  RAZORPAY
}

// Mirrors the lifecycle in the Cashfree Easy Split handover doc (section 6):
// ORDER_CREATED -> PAYMENT_PENDING -> PAYMENT_SUCCESS/FAILED. The app's own
// state is authoritative — never inferred from an unverified frontend
// callback (section 7).
enum PaymentStatus {
  ORDER_CREATED
  PAYMENT_PENDING
  PAYMENT_SUCCESS
  PAYMENT_FAILED
}

// Tracked separately from PaymentStatus because a payment can be
// successfully collected (PAYMENT_SUCCESS) while its Easy Split to the
// Mandal vendor still fails/retries (handover doc section 26, Case 4) — the
// donation must stay marked paid regardless of split outcome.
enum SplitStatus {
  NOT_APPLICABLE
  SPLIT_PENDING
  SPLIT_SUCCESS
  SPLIT_FAILED
}

enum SettlementStatus {
  SETTLEMENT_PENDING
  SETTLED
}

// Cashfree Easy Split vendor onboarding state for a Mandal (handover doc
// section 36). A Mandal may only accept online donations once this is
// ACTIVE and Organization.paymentEnabled is true.
enum CashfreeVendorStatus {
  NOT_STARTED
  DETAILS_SUBMITTED
  VENDOR_CREATED
  BANK_VALIDATION
  KYC_REVIEW
  ACTIVE
  ACTION_REQUIRED
  REJECTED
  SUSPENDED
}

// DonationCategory/ExpenseCategory used to be native enums here, constraining
// Receipt.category/Expense.category to a fixed system-wide list. They're now
// plain strings (see those models below) so an org can add its own custom
// categories (CustomCategory) on top of the curated presets, which still live
// on as plain TypeScript enums in packages/shared (RECEIPT_CATEGORIES_LABELS /
// EXPENSE_CATEGORY_LABELS) — this Prisma enum just isn't one of them anymore.
enum CategoryKind {
  EXPENSE
  DONATION
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Organization {
  id                String  @id @default(uuid())
  name              String
  nameMarathi       String?
  nameHindi         String?
  slug              String  @unique
  // Short, memorable login identifier — distinct from `slug` (a long,
  // name-derived string with a random suffix, not something you'd read out
  // over WhatsApp). A collector's phone number is only unique *within* an
  // org (@@unique([orgId, phone]) on User below), so logging in by phone
  // alone is ambiguous the moment two mandals happen to have staff sharing a
  // number — this is what actually disambiguates which org's User row a
  // login resolves to. Shown to ORG_ADMIN in Settings; every collector needs
  // it alongside their phone + password (2026-08 mandal code introduction).
  mandalCode        String  @unique
  address           String
  city              String
  state             String  @default("Maharashtra")
  pincode           String?
  phone             String  @unique
  email             String? @unique
  logoUrl           String?
  regNumber         String?
  bankName          String?
  bankAccountNumber String?
  bankIfsc          String?
  bankBranch        String?
  upiId             String?
  brandColor        String?

  // Cashfree Easy Split vendor identity for this Mandal (handover doc
  // sections 2-4, 34, 36) — each org gets its own vendor so donor payments
  // split straight to the org's own bank, never a shared platform account.
  // Nullable/NOT_STARTED until the org actually onboards for online
  // donations; existing orgs (cash/manual receipts) are unaffected.
  cashfreeVendorId     String?
  cashfreeVendorStatus CashfreeVendorStatus @default(NOT_STARTED)
  paymentEnabled       Boolean              @default(false)

  subscriptionPlan   SubscriptionPlan   @default(FREE)
  subscriptionStatus SubscriptionStatus @default(PENDING_PAYMENT)
  subscriptionExpiry DateTime?
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  users            User[]
  campaigns        Campaign[]
  payments         Payment[]
  areas            CollectorArea[]
  auditLogs        AuditLog[]
  members          Member[]
  customCategories CustomCategory[]

  receiptTemplateSettings Json?
  // { instagram?, facebook?, youtube?, website? } — see OrganizationSocialLinks
  // in packages/shared, rendered on the pavti (ReceiptPreview + pdf.service.ts).
  socialLinks             Json?

  @@index([slug])
}

// Org-extensible categories layered on top of the curated presets (see the
// CategoryKind comment above) — lets a treasurer add "Catering" or "Stage
// Decor" from the expense form itself instead of being stuck with the fixed
// list or needing a Settings trip.
model CustomCategory {
  id        String       @id @default(uuid())
  orgId     String
  kind      CategoryKind
  label     String
  createdAt DateTime     @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, kind, label])
  @@index([orgId, kind])
}

model Member {
  id        String   @id @default(uuid())
  orgId     String
  name      String
  phone     String?
  address   String?
  isActive  Boolean  @default(true)
  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contributions Receipt[]

  @@index([orgId])
}

model User {
  id           String    @id @default(uuid())
  orgId        String
  name         String
  phone        String
  email        String?
  passwordHash String?
  role         UserRole  @default(COLLECTOR)
  areaId       String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  refreshToken String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  organization  Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  area          CollectorArea? @relation(fields: [areaId], references: [id])
  receipts      Receipt[]
  expensesAdded Expense[]      @relation("ExpenseAddedBy")
  auditLogs     AuditLog[]

  @@unique([orgId, phone])
  @@index([orgId])
  @@index([phone])
}

model CollectorArea {
  id          String  @id @default(uuid())
  orgId       String
  name        String
  description String?

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  collectors   User[]
  receipts     Receipt[]

  @@index([orgId])
}

model Campaign {
  id            String         @id @default(uuid())
  orgId         String
  name          String
  nameMarathi   String?
  nameHindi     String?
  year          Int
  startDate     DateTime
  endDate       DateTime?
  targetAmount  Float?
  receiptPrefix String
  receiptSeq    Int            @default(0)
  status        CampaignStatus @default(DRAFT)
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  receipts     Receipt[]
  expenses     Expense[]

  @@unique([orgId, receiptPrefix])
  @@index([orgId])
}

model Receipt {
  id               String         @id @default(uuid())
  campaignId       String
  collectorId      String
  areaId           String?
  memberId         String?
  receiptNumber    String         @unique
  donorName        String
  donorPhone       String?
  donorAddress     String?
  amount           Float
  amountInWords    String
  // Plain string, not a Postgres enum — see CategoryKind comment above.
  // Preset values still come from packages/shared's DonationCategory enum;
  // this column also accepts an org's CustomCategory labels.
  category         String         @default("GENERAL")
  paymentMode      PaymentMode    @default(CASH)
  chequeNumber     String?
  notes            String?
  pdfUrl           String?
  qrCodeData       String?
  latitude         Float?
  longitude        Float?
  deviceInfo       String?
  isVoided         Boolean        @default(false)
  voidReason       String?
  voidedAt         DateTime?
  voidedById       String?
  collectionType   CollectionType @default(DONATION)
  status           ReceiptStatus  @default(PAID)
  dueDate          DateTime?
  contributorType  String?
  supportingDocUrl String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  campaign  Campaign       @relation(fields: [campaignId], references: [id])
  collector User           @relation(fields: [collectorId], references: [id])
  area      CollectorArea? @relation(fields: [areaId], references: [id])
  member    Member?        @relation(fields: [memberId], references: [id])
  // Only set for donations collected online via Cashfree (see Payment
  // below) — a manually-entered cash/UPI-at-hand receipt has no Payment row.
  // Per the handover doc (section 28) the Receipt itself is only created
  // once payment reaches PAYMENT_SUCCESS, so this is set at receipt-creation
  // time, not backfilled.
  payment   Payment?

  @@index([campaignId])
  @@index([collectorId])
  @@index([createdAt])
  @@index([receiptNumber])
  @@index([memberId])
}

// One online donation payment, tracked independently of Receipt so the
// app's own state machine (handover doc section 6) survives regardless of
// whether/when a Receipt gets generated. Amounts are stored in integer
// paise (handover doc section 22 — never float money math); convert to
// rupees only at the API/display boundary.
model Payment {
  id        String          @id @default(uuid())
  orgId     String
  receiptId String?         @unique
  provider  PaymentProvider @default(CASHFREE)

  // Our own order id, e.g. `DP_SB_<uuid>` — sent to Cashfree as order_id.
  // Never reused (handover doc section 14).
  orderId           String  @unique
  cashfreeOrderId   String? @unique
  cashfreePaymentId String?
  cashfreeSplitId   String?
  // The exact session handed to the frontend at creation (2026-08-23 fix) —
  // found live: Cashfree's GET /orders/{id} returns a *different*
  // payment_session_id string on every call, even seconds apart, for the
  // same still-ACTIVE order. Re-deriving a "reusable" session from that
  // endpoint is what was producing "payment_session_id is not present or
  // is invalid" on Cashfree's own checkout page. Storing the original here
  // means idempotent reuse hands back the one session actually known to
  // have been valid, instead of gambling on GET minting something usable.
  paymentSessionId String?
  // Which plan this order is actually FOR — distinct from the org's plan
  // at the moment the order was created. A plain renewal sets this to the
  // org's current plan; a Change Plan action (subscription page) sets it
  // to the newly-chosen plan. Null on Payment rows created before this
  // column existed — the webhook falls back to "no plan change" for those.
  targetPlan String?

  amountPaise       Int
  platformFeePaise  Int    @default(0)
  mandalAmountPaise Int    @default(0)
  currency          String @default("INR")

  donorName  String
  donorPhone String
  donorEmail String?

  status           PaymentStatus     @default(ORDER_CREATED)
  splitStatus      SplitStatus       @default(NOT_APPLICABLE)
  settlementStatus SettlementStatus?
  failureReason    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  paidAt    DateTime?

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  receipt      Receipt?     @relation(fields: [receiptId], references: [id])

  @@index([orgId])
  @@index([status])
  @@index([createdAt])
}

// Cashfree webhook events, kept for idempotency (handover doc section 20) —
// a webhook must never be processed twice for the same event.
model PaymentWebhookEvent {
  id          String          @id @default(uuid())
  provider    PaymentProvider @default(CASHFREE)
  eventId     String // Cashfree's own event/webhook id
  eventType   String
  paymentId   String? // our Payment.id, once resolved
  payloadHash String
  receivedAt  DateTime        @default(now())
  processedAt DateTime?
  status      String          @default("RECEIVED") // RECEIVED | PROCESSED | IGNORED | FAILED

  @@unique([provider, eventId])
  @@index([paymentId])
}

// Plain ledger entry — no approval workflow (see ExpensesService comment).
model Expense {
  id               String      @id @default(uuid())
  campaignId       String
  addedById        String
  // Plain string, not a Postgres enum — see CategoryKind comment above.
  category         String
  amount           Float
  description      String
  receiptUrl       String?
  paidTo           String      @default("")
  beneficiaryPhone String?
  gstNumber        String?
  paymentMode      PaymentMode @default(CASH)
  expenseDate      DateTime    @default(now())
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id])
  addedBy  User     @relation("ExpenseAddedBy", fields: [addedById], references: [id])

  @@index([campaignId])
}

model AuditLog {
  id         String   @id @default(uuid())
  orgId      String?
  userId     String
  action     String
  entity     String
  entityId   String
  oldValue   Json?
  newValue   Json?
  deviceInfo String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  organization Organization? @relation(fields: [orgId], references: [id])
  user         User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([orgId])
  @@index([entity, entityId])
  @@index([createdAt])
}
