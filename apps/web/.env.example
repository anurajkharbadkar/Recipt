# =============================================================
# e-Pavti Book - Web Environment Variables
# Copy this file to .env.local and fill in your values
# =============================================================

# ── API ───────────────────────────────────────────────────────
# Local dev: http://localhost:3001/api/v1
# Production: https://api.epavtibook.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ── App's own public URL ─────────────────────────────────────
# Local dev: http://localhost:3010 (or 3000, whichever this app runs on)
# Production: https://app.epavtibook.com
NEXT_PUBLIC_APP_URL=http://localhost:3010

# ── Platform WhatsApp number ─────────────────────────────────
# Used for the "Request Access via WhatsApp" / support links (platformWhatsappLink,
# lib/platform.ts) — a plain wa.me click-to-chat number, no API/credentials.
# Format: country code + number, no + or spaces (e.g. 91XXXXXXXXXX).
NEXT_PUBLIC_PLATFORM_WHATSAPP=919225398060
